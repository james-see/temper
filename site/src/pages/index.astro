---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.svelte";
import CopyCmd from "../components/CopyCmd.svelte";

const commands = [
  ["temper", "open the TUI"],
  ['temper run "fix the auth tests"', "supervised run"],
  ['temper run --plain "..."', "no TUI, events on stdout"],
  ["temper inspect <run-id>", "replay the event stream"],
  ["temper config show", "agents, providers, reflex"],
];
---

<Base
  title="Temper — the open-source control plane for coding agents"
  description="Temper is the open-source control plane for coding agents. It supervises Cursor, Claude Code, Codex, and OpenCode, and uses Reflex to detect progress, stalls, and loops. Install: brew tap james-see/tap && brew install temper. https://github.com/james-see/temper"
>
  <header class="top">
    <a class="brand" href="https://temper.baby">
      <img src="/logo.png" alt="Temper" width="40" height="40" />
      <span>TEMPER</span>
    </a>
    <nav>
      <a href="https://github.com/james-see/temper">github</a>
      <a href="#manual">install</a>
    </nav>
  </header>

  <main>
    <Terminal client:load />

    <h1>The open-source control plane for coding agents</h1>
    <p class="deck">
      Supervises Cursor, Claude Code, Codex, and OpenCode. Reflex detects progress, stalls, and
      loops.
    </p>

    <section id="manual" class="manual">
      <h2>install</h2>
      <CopyCmd client:idle />

      <h2>commands</h2>
      <dl>
        {
          commands.map(([cmd, note]) => (
            <div class="cmd">
              <dt><code>{cmd}</code></dt>
              <dd>{note}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>

  <footer class="foot">
    <p>
      Temper is <a href="https://github.com/james-see/temper/blob/main/LICENSE">Apache-2.0</a>.
      <a href="https://github.com/james-see/temper">github.com/james-see/temper</a>
    </p>
    <p class="note">
      Optional local Reflex judge uses LFM2.5 under LFM Open License v1.0 (not OSI;
      $10M revenue cliff). Temper itself is Apache-2.0. Weights are not vendored.
    </p>
  </footer>
</Base>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 20px 18px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--paper);
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
  }

  .brand span {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(22px, 4.4vw, 32px);
    letter-spacing: 0.12em;
    line-height: 1;
    color: var(--paper);
  }

  nav {
    display: flex;
    gap: 18px;
    font-size: 13px;
  }

  nav a {
    color: var(--dim);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--paper);
  }

  main {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 20px 48px;
  }

  h1 {
    margin: 28px 0 0;
    color: var(--paper);
    font-size: clamp(18px, 2.6vw, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 28ch;
  }

  .deck {
    margin: 10px 0 0;
    color: var(--dim);
    font-size: 14px;
    max-width: 52ch;
  }

  .manual {
    margin-top: 40px;
  }

  h2 {
    margin: 28px 0 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: var(--dim);
  }

  dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .cmd {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    margin: 0;
  }

  dt code {
    font-family: inherit;
    font-size: 13px;
    color: var(--paper);
  }

  dd {
    margin: 0;
    color: var(--dim);
    font-size: 13px;
  }

  .foot {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 20px 48px;
    color: var(--dim);
    font-size: 12px;
  }

  .foot p {
    margin: 0 0 10px;
  }

  .note {
    max-width: 72ch;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .cmd {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
